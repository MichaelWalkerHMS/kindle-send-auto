{
  "manifest_version": 3,
  "name": "Kindle Send",
  "version": "2.1.1",
  "description": "Save web articles and build Kindle-ready EPUBs with full-resolution images and popup footnotes.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Kindle Send",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kindle-send-auto@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
